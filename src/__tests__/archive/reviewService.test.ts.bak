"""API routes for reviews.

This module defines the API endpoints for managing product reviews.
"""
import express from 'express'
import { db } from '../database/connection.js'
import { body, param, validationResult } from 'express-validator'
import { authenticate } from '../middleware/auth.js'

const router = express.Router()

/**
 * Create a new review
 * POST /api/v1/reviews/
 * Requires authentication
 */
router.post('/', [
  authenticate,
  body('product_id').isInt({ min: 1 }).withMessage('Valid product ID is required'),
  body('rating').isInt({ min: 1, max: 5 }).withMessage('Rating must be between 1 and 5'),
  body('comment').isLength({ min: 10, max: 1000 }).withMessage('Comment must be between 10 and 1000 characters'),
  body('order_id').optional().isString(),
], async (req, res) => {
  const errors = validationResult(req)
  if (!errors.isEmpty()) {
    return res.status(400).json({ success: false, errors: errors.array() })
  }

  try {
    const { product_id, rating, comment, order_id } = req.body
    const user_id = req.user?.id

    // Check if user has purchased the product
    const hasPurchased = await checkUserPurchase(product_id, user_id)
    if (!hasPurchased.eligible) {
      return res.status(403).json({
        success: false,
        message: 'You can only review products you have purchased and received',
        order_id: hasPurchased.order_id
      })
    }

    // Check if user has already reviewed this product
    const existingReview = await db.query(
      'SELECT id FROM reviews WHERE product_id = ? AND user_id = ?',
      [product_id, user_id]
    )

    if (existingReview.length > 0) {
      return res.status(409).json({\n        success: false,\n        message: 'You have already reviewed this product',
        review_id: existingReview[0].id
      })
    }

    // Create the new review
    const result = await db.query(
      `INSERT INTO reviews (product_id, user_id, rating, comment, order_id, created_at)
       VALUES (?, ?, ?, ?, ?, NOW())`,
      [product_id, user_id, rating, comment, order_id || null]
    )

    const review_id = result.insertId

    // Get the created review
    const review = await db.query(
      `SELECT r.id, r.product_id, r.user_id, r.rating, r.comment, r.order_id, r.created_at,
              u.name as user_name, u.email as user_email
       FROM reviews r
       JOIN users u ON r.user_id = u.id
       WHERE r.id = ?`,
      [review_id]
    )

    // Update product average rating
    await updateProductRating(product_id)

    return res.status(201).json({
      success: true,
      message: 'Review submitted successfully',
      data: { review: review[0] }
    })
  } catch (error) {
    console.error('Error creating review:', error)
    return res.status(500).json({
      success: false,
      message: 'Failed to submit review'
    })
  }
})

/**
 * Get reviews for a product
 * GET /api/v1/reviews/product/:productId
 */
router.get('/product/:productId', [
  param('productId').isInt({ min: 1 }).withMessage('Valid product ID is required'),
], async (req, res) => {
  const errors = validationResult(req)
  if (!errors.isEmpty()) {
    return res.status(400).json({ success: false, errors: errors.array() })
  }

  try {
    const { productId } = req.params

    // Get all reviews for the product
    const reviews = await db.query(
      `SELECT r.id, r.product_id, r.user_id, r.rating, r.comment, r.order_id, r.created_at,
              u.name as user_name, u.email as user_email
       FROM reviews r
       JOIN users u ON r.user_id = u.id
       WHERE r.product_id = ?
       ORDER BY r.created_at DESC`,
      [productId]
    )

    // Get review statistics
    const stats = await db.query(
      `SELECT 
              COUNT(*) as total,
              AVG(rating) as average,
              MIN(rating) as min,
              MAX(rating) as max,
              SUM(CASE WHEN rating = 5 THEN 1 ELSE 0 END) as five_star,
              SUM(CASE WHEN rating = 4 THEN 1 ELSE 0 END) as four_star,
              SUM(CASE WHEN rating = 3 THEN 1 ELSE 0 END) as three_star,
              SUM(CASE WHEN rating = 2 THEN 1 ELSE 0 END) as two_star,
              SUM(CASE WHEN rating = 1 THEN 1 ELSE 0 END) as one_star
       FROM reviews
       WHERE product_id = ?`,
      [productId]
    )

    return res.json({
      success: true,
      data: {
        reviews,
        statistics: {
          total: stats[0]?.total || 0,
          average: stats[0]?.average ? Number(stats[0].average).toFixed(2) : 0,
          distribution: {
            five_star: stats[0]?.five_star || 0,
            four_star: stats[0]?.four_star || 0,
            three_star: stats[0]?.three_star || 0,
            two_star: stats[0]?.two_star || 0,
            one_star: stats[0]?.one_star || 0,
          },
          min: stats[0]?.min || 0,
          max: stats[0]?.max || 0,
        }
      }
    })
  } catch (error) {
    console.error('Error getting reviews:', error)
    return res.status(500).json({
      success: false,
      message: 'Failed to retrieve reviews'
    })
  }
})

/**
 * Check if user can review a product
 * GET /api/v1/reviews/check/:productId
 */
router.get('/check/:productId', [
  authenticate,
  param('productId').isInt({ min: 1 }).withMessage('Valid product ID is required'),
], async (req, res) => {
  const errors = validationResult(req)
  if (!errors.isEmpty()) {
    return res.status(400).json({ success: false, errors: errors.array() })
  }

  try {
    const { productId } = req.params
    const user_id = req.user?.id

    const canReview = await checkUserPurchase(productId, user_id)

    return res.json({
      success: true,
      data: {
        eligible: canReview.eligible,
        order_id: canReview.order_id,
        has_reviewed: await hasUserReviewed(productId, user_id)
      }
    })
  } catch (error) {
    console.error('Error checking review eligibility:', error)
    return res.status(500).json({
      success: false,
      message: 'Failed to check review eligibility'
    })
  }
})

/**
 * Helper function to check if user purchased and received product
 */
async function checkUserPurchase(product_id: number, user_id: number): Promise<{ eligible: boolean; order_id: string }> {
  // Get all delivered orders for the user containing this product
  const orders = await db.query(
    `SELECT o.order_id, o.order_number, o.delivered_at
     FROM orders o
     JOIN order_items oi ON o.id = oi.order_id
     WHERE o.user_id = ? AND o.status IN ('delivered', 'completed')
       AND oi.product_id = ?
     ORDER BY o.delivered_at DESC
     LIMIT 1`,
    [user_id, product_id]
  )

  if (orders.length === 0) {
    return { eligible: false, order_id: '' }
  }

  // Check if user has already reviewed this product
  const existingReview = await db.query(
    'SELECT id FROM reviews WHERE product_id = ? AND user_id = ?',
    [product_id, user_id]
  )

  const orderId = orders[0].order_id || orders[0].order_number || ''

  return {
    eligible: existingReview.length === 0,
    order_id: orderId
  }
}

/**
 * Helper function to check if user has reviewed a product
 */
async function hasUserReviewed(product_id: number, user_id: number): Promise<boolean> {
  const reviews = await db.query(
    'SELECT id FROM reviews WHERE product_id = ? AND user_id = ?',
    [product_id, user_id]
  )

  return reviews.length > 0
}

/**
 * Update product average rating
 */
async function updateProductRating(product_id: number): Promise<void> {
  const stats = await db.query(
    `SELECT AVG(rating) as average_rating, COUNT(*) as review_count
     FROM reviews
     WHERE product_id = ?`,
    [product_id]
  )

  await db.query(
    'UPDATE products SET rating = ?, review_count = ? WHERE id = ?',
    [stats[0].average_rating, stats[0].review_count, product_id]
  )
}

export default router
